# Base de Données PostgreSQL (ASYNC pour l'application)
DATABASE_URL=postgresql+asyncpg://admin:secret@localhost:5432/breast_cancer_db

# Base de Données PostgreSQL (SYNC pour les migrations Alembic)
DATABASE_SYNC_URL=postgresql://admin:secret@localhost:5432/breast_cancer_db

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant (Vector Database)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Redis (Cache / Event Bus)
REDIS_URL=redis://localhost:6379

# Dossier où seront stockés les modèles lourds (SAM2, YOLO, LLM, etc.)
MODEL_CACHE_DIR=./models_cache